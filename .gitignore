# Workspace-level ignores
.venv/
.vscode/
__pycache__/

# Python artifacts
*.py[cod]
*.so
.pytest_cache/
.coverage
.tox/
*.egg-info/
build/

# Environment files
.*env

# Databases and exports
*.db
*.sqlite
*.csv

# Logs
*.log
rhytmic.log*

# Uploaded media, Never committed
rhythmic/media/

# Machine-local Claude Code config: absolute paths and this clone's permission
# grants. `.claude/skills/` is shared and stays tracked.
.claude/settings.local.json
.claude/settings.local.json.doctor-backup
