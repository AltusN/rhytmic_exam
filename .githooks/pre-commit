#!/bin/sh
# Blocks a commit when rhythmic/ is not ruff-clean.
#
# Enable once per clone:
#     git config core.hooksPath .githooks
#
# Ruff runs from rhythmic/, never the repo root: there is no config file at the
# root, so ruff would fall back to its defaults and walk legacy/.
#
# Deliberately does NOT run the test suite. That is a slower, separate gate --
# a commit hook you start dreading is a commit hook you start bypassing.
#
# Bypass with `git commit --no-verify` when you mean to.

set -e

repo_root=$(git rev-parse --show-toplevel)

# Only the Python files staged for THIS commit. Checking all of rhythmic/ would
# block a finished commit because of unrelated work in progress elsewhere.
staged=$(git diff --cached --name-only --diff-filter=ACMR | grep '^rhythmic/.*\.py$' || true)
if [ -z "$staged" ]; then
    exit 0
fi

# Paths relative to rhythmic/, which is where ruff has to run from.
files=$(printf '%s\n' "$staged" | sed 's|^rhythmic/||')

if [ -x "$repo_root/.venv/bin/ruff" ]; then
    ruff="$repo_root/.venv/bin/ruff"
elif command -v ruff >/dev/null 2>&1; then
    ruff=ruff
else
    echo "pre-commit: ruff not found in .venv/bin or on PATH." >&2
    echo "            install the dev extra, or commit with --no-verify." >&2
    exit 1
fi

cd "$repo_root/rhythmic"

# Check the STAGED CONTENT, not the working-tree file.
#
# `git show ":path"` prints the blob in the index -- exactly the bytes this commit
# will contain. Checking the file on disk instead lets this slip through:
#
#     git add file      # stages a dirty version
#     ruff format .     # cleans the working tree
#     git commit        # hook sees a clean working tree, commits the dirty blob
#
# which is how the whitespace in 37500f1 was committed. `--stdin-filename` gives
# ruff the path it would have had, so per-file config resolution still applies and
# scoring/ still gets its framework ban.
#
# `git stash --keep-index` would also work and was rejected: a hook that stashes
# can lose work if it exits badly.
status=0
for f in $files; do
    if ! git show ":rhythmic/$f" | "$ruff" format --check --stdin-filename "$f"; then
        status=1
    fi
    if ! git show ":rhythmic/$f" | "$ruff" check --stdin-filename "$f"; then
        status=1
    fi
done

if [ "$status" -ne 0 ]; then
    echo >&2
    echo "pre-commit: staged content is not ruff-clean, commit aborted." >&2
    echo "  formatting:  cd rhythmic && ../.venv/bin/ruff format ." >&2
    echo "  lint:        cd rhythmic && ../.venv/bin/ruff check ." >&2
    echo "  then RE-STAGE. This checks the staged blob, so fixing the file on" >&2
    echo "  disk without a fresh 'git add' changes nothing." >&2
fi

exit $status
